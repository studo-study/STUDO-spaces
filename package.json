{
  "name": "studo-spaces",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "pnpm --filter @studo/web dev",
    "dev:api": "pnpm --filter @studo/api-node start:dev",
    "build:web": "pnpm --filter @studo/web build",
    "build:api": "pnpm --filter @studo/api-node build",
    "db:generate": "pnpm --filter @studo/api-node db:generate",
    "db:migrate": "pnpm --filter @studo/api-node db:migrate",
    "db:seed": "pnpm --filter @studo/api-node db:seed",
    "db:reset": "pnpm --filter @studo/api-node db:reset",
    "db:reset-and-seed": "pnpm --filter @studo/api-node db:reset-and-seed",
    "env:sync": "cp .env apps/api-node/.env && cp .env apps/web/.env && cp .env apps/legacy/.env && sed -i '' 's|AUTH_URL=http://localhost:4000/|AUTH_URL=http://localhost:5173/|' apps/legacy/.env && sed -i '' 's|NEXT_PUBLIC_FRONTEND=http://localhost:4000/|NEXT_PUBLIC_FRONTEND=http://localhost:5173/|' apps/legacy/.env"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "**/*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
