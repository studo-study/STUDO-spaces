{
  "name": "studo-spaces",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "turbo run lint",
    "dev:web": "dotenv -e .env -- pnpm --filter @studo/web dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @studo/api-node start:dev",
    "build:web": "dotenv -e .env -- pnpm --filter @studo/web build",
    "build:api": "dotenv -e .env -- pnpm --filter @studo/api-node build",
    "db:generate": "pnpm --filter @studo/api-node db:generate",
    "db:migrate:node": "pnpm --filter @studo/api-node db:migrate",
    "db:migrate:rust": "cd workers && diesel print-schema > src/schema.rs",
    "db:migrate": "pnpm --filter @studo/api-node db:migrate && cd workers && diesel print-schema > src/schema.rs",
    "db:seed": "pnpm --filter @studo/api-node db:seed",
    "db:reset": "pnpm --filter @studo/api-node db:reset",
    "db:reset-and-seed": "pnpm --filter @studo/api-node db:reset-and-seed",
    "web:cleanup": "pnpm --filter @studo/web rm -rf .next",
    "web:inspect": "dotenv -e .env -- env NODE_OPTIONS='--max-old-space-size=4096 --inspect' pnpm --filter @studo/web dev",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "**/*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "dependencies": {
    "vercel": "^54.1.0"
  }
}
