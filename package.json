{
  "name": "studo-spaces",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:web": "pnpm --filter @studo/web dev",
    "dev:api": "pnpm --filter @studo/backend start:dev",
    "build:web": "pnpm --filter @studo/web build",
    "build:api": "pnpm --filter @studo/backend build",
    "db:generate": "pnpm --filter @studo/backend db:generate",
    "db:migrate": "pnpm --filter @studo/backend db:migrate",
    "db:seed": "pnpm --filter @studo/backend db:seed",
    "db:reset": "pnpm --filter @studo/backend db:reset"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.33.0"
}