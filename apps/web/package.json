{
  "name": "@studo/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy-pdf-worker": "node -e \"require('fs').copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'), 'public/pdf.worker.min.mjs')\"",
    "predev": "pnpm copy-pdf-worker",
    "prebuild": "pnpm copy-pdf-worker",
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev -p 4000 --turbopack",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=8192' NEXT_DISABLE_TURBOPACK=1 next dev -p 4000",
    "quick": "next dev -p 4000 --no-turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint . --fix",
    "analyze": "pnpm next experimental-analyze",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@studo/i18n": "workspace:*",
    "@studo/types": "workspace:*",
    "@studo/ui": "workspace:*",
    "@studo/utils": "workspace:*",
    "@tanstack/react-query": "^5.90.16",
    "animate.css": "^4.1.1",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.5.2",
    "firebase": "^12.9.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.5",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "4.9.2",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^10.0.3",
    "react-pdf": "^10.4.1",
    "resend": "^6.9.2",
    "shiki": "^4.1.0",
    "sortablejs": "^1.15.6",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sortablejs": "^1.15.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
