PORT=3001
NODE_ENV=test

AUTH_HASH_LENGTH=32
AUTH_HASH_MEMORY_COST=65536
AUTH_HASH_TIME_COST=6
AUTH_JWT_AUDIENCE=studo-api
AUTH_JWT_EXPIRATION_INTERVAL=2592000
AUTH_JWT_ISSUER=studo-api
AUTH_JWT_SECRET=test-secret-do-not-use-in-production
AUTH_MAX_DELAY=0

CORS_ORIGINS='["http://localhost:3001"]'

# Overridden at runtime by Testcontainers global setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studo_test

FRONTEND_URL=http://localhost:3001

GOOGLE_CALLBACK_URL=http://localhost:3001/api/sessions/google/callback
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret

MICROSOFT_CALLBACK_URL=http://localhost:3001/api/sessions/microsoft/callback
MICROSOFT_CLIENT_ID=test-microsoft-client-id
MICROSOFT_CLIENT_SECRET=test-microsoft-client-secret

FACEBOOK_CALLBACK_URL=http://localhost:3001/api/sessions/facebook/callback
FACEBOOK_CLIENT_ID=test-facebook-client-id
FACEBOOK_CLIENT_SECRET=test-facebook-client-secret

SCALEWAY_ACCESS_KEY=test-access-key
SCALEWAY_BUCKET_NAME=test-bucket
SCALEWAY_REGION=fr-par
SCALEWAY_SECRET_KEY=test-secret-key
SCW_DEFAULT_ORGANIZATION_ID=test-org-id
SCW_DEFAULT_PROJECT_ID=test-project-id

GEMINI_API_KEY=test-gemini-key
